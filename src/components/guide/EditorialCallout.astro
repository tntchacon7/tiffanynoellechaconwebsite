---
// [R5 ADDITION] Small reusable editorial callout for Reading Room guides —
// a bordered, tinted aside used to set a specific idea apart from the
// surrounding prose (e.g. Tiffany's own content promise, a quick
// definition, a disclosure). Not a new design system: colors, radius,
// spacing, and type all come from the existing tokens in tokens.css.
export interface Props {
  eyebrow?: string;
  title?: string;
  variant?: "accent" | "quiet";
}
const { eyebrow, title, variant = "accent" } = Astro.props;
---

<aside class={`gcallout gcallout--${variant}`}>
  {eyebrow && <p class="eyebrow gcallout__eyebrow">{eyebrow}</p>}
  {title && <p class="gcallout__title">{title}</p>}
  <div class="gcallout__body">
    <slot />
  </div>
</aside>

<style>
  .gcallout {
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    margin-block: var(--space-lg);
  }
  .gcallout--accent {
    background: color-mix(in srgb, var(--color-tiffany) 8%, var(--color-bg));
    border: 1px solid color-mix(in srgb, var(--color-tiffany) 25%, transparent);
  }
  .gcallout--quiet {
    background: var(--color-surface);
    border: var(--border-hairline);
  }
  .gcallout__eyebrow {
    margin-bottom: var(--space-3xs);
  }
  .gcallout__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }
  .gcallout__body {
    color: var(--color-ink);
    font-size: var(--step-0);
  }
  .gcallout__body :global(p) {
    margin-block: var(--space-2xs);
  }
  .gcallout__body :global(p:first-child) {
    margin-top: 0;
  }
  .gcallout__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .gcallout__body :global(strong) {
    color: var(--color-ink);
  }
</style>
