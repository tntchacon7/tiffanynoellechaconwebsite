---
// [R5 ADDITION] Editorial pull-quote treatment for Reading Room guides.
// Used sparingly to break up long-form prose with a single memorable line
// — never a verbatim transcript excerpt, always an adapted, standalone
// sentence appropriate for a pull quote's short, self-contained form.
export interface Props {
  attribution?: string;
}
const { attribution } = Astro.props;
---

<figure class="pullquote">
  <blockquote>
    <p><slot /></p>
  </blockquote>
  {attribution && <figcaption>{attribution}</figcaption>}
</figure>

<style>
  .pullquote {
    margin: var(--space-xl) 0;
    padding-left: var(--space-lg);
    border-left: 3px solid var(--color-tiffany);
  }
  .pullquote blockquote {
    margin: 0;
  }
  .pullquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  .pullquote figcaption {
    margin-top: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
