---
// [R3 NEW PAGE] Standalone-book variant, same pattern as the-comeback-play.astro.
// This book has no `series` (it's "A Clean Romance Podcast Novella",
// co-written with Sarah Hickner), so per Tyler's R3 decision 5: no series
// breadcrumb segment, no series-context section, and a factual
// "Collaboration" row instead of Series/Position. Unlike the other two
// standalone titles, this one IS co-authored, so it also gets the
// SeriesCoauthor section (same component/eyebrow used on Promise You the
// Moon and Shoot the Moon) and a Co-Author row in the details table — both
// already generalized, not new logic.
import BaseLayout from "../../layouts/BaseLayout.astro";
import RetailCTA from "../../components/book/RetailCTA.astro";
import SeriesCoauthor from "../../components/book/SeriesCoauthor.astro";
import Newsletter from "../../components/shared/Newsletter.astro";
import { getBookBySlug } from "../../data/catalog.js";

const book = getBookBySlug("a-holly-jolly-christmas-cubicle");
const coauthor = book.authors.find((a) => a.slug !== "tiffany-noelle-chacon");

const contentPromiseLabel =
  book.content.cleanKissesOnly && book.content.noProfanity ? "Kisses only, no profanity" : null;
---

<BaseLayout title={`${book.title} — Tiffany Noelle Chacon`} description={book.hook}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="wrap wrap--wide breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="/">Home</a>
        <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      </li>
      <li class="breadcrumbs__item">
        <a href="/books/">My Books</a>
        <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      </li>
      <li class="breadcrumbs__item">
        <span aria-current="page">{book.title}</span>
      </li>
    </ol>
  </nav>

  <section class="book-hero" style="--_accent-text: var(--color-tiffany-text)">
    <div class="wrap wrap--wide">
      <div class="book-hero__grid">
        <div class="book-hero__copy">
          <p class="eyebrow">{book.collaboration}</p>
          <h1 class="book-hero__title">{book.title}</h1>
          <p class="book-hero__byline">
            By {book.authors[0].name}
            {coauthor && (
              <Fragment>
                {" "}&amp;{" "}
                {coauthor.url ? (
                  <a class="book-hero__byline-link" href={coauthor.url} target="_blank" rel="noopener noreferrer">{coauthor.name}</a>
                ) : (
                  coauthor.name
                )}
              </Fragment>
            )}
          </p>
          <div class="book-hero__actions">
            <RetailCTA retail={book.retail} />
          </div>
        </div>
        <div class="book-hero__media">
          <div class="book-hero__cover">
            <div class="cover">
              <img src={book.cover.image} alt={book.cover.alt} width="480" height="768" loading="eager" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface book-promise" aria-label="Content promise">
    <div class="wrap wrap--narrow book-promise__inner">
      <hr class="rule--accent" />
      <p class="book-promise__statement">Kisses only. No explicit scenes. Ever.</p>
    </div>
  </section>

  <section class="section book-description" aria-labelledby="book-description-heading">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">The Story</p>
      <h2 class="visually-hidden" id="book-description-heading">About the Book</h2>
      <p class="book-description__hook">{book.hook}</p>
      {book.blurb && (
        <div class="book-description__blurb">
          {book.blurb.split("\n\n").map((para) => (
            <p>{para}</p>
          ))}
        </div>
      )}
    </div>
  </section>

  {coauthor && (
    <SeriesCoauthor
      eyebrow="A Two-Author Book"
      body={`${book.title} is co-written by ${book.authors[0].name} and ${coauthor.name}.`}
      coauthorName={coauthor.name}
      coauthorUrl={coauthor.url}
      accentTextVar="var(--color-tiffany-text)"
    />
  )}

  <section class="section section--tight section--surface book-details" aria-labelledby="book-details-heading">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">At a Glance</p>
      <h2 class="visually-hidden" id="book-details-heading">Book Details</h2>
      <dl class="book-details__list">
        <div class="book-details__row">
          <dt>Collaboration</dt>
          <dd>{book.collaboration}</dd>
        </div>
        {coauthor && (
          <div class="book-details__row">
            <dt>Co-Author</dt>
            <dd>{coauthor.url ? <a href={coauthor.url}>{coauthor.name}</a> : coauthor.name}</dd>
          </div>
        )}
        {book.tropes.length > 0 && (
          <div class="book-details__row">
            <dt>Tropes</dt>
            <dd>{book.tropes.join(", ")}</dd>
          </div>
        )}
        {book.setting && (
          <div class="book-details__row">
            <dt>Setting</dt>
            <dd>{book.setting}</dd>
          </div>
        )}
        {contentPromiseLabel && (
          <div class="book-details__row">
            <dt>Content Promise</dt>
            <dd>{contentPromiseLabel}</dd>
          </div>
        )}
        {book.awards.length > 0 && (
          <div class="book-details__row">
            <dt>Awards</dt>
            <dd>{book.awards.map((a) => `Winner — ${a.name}`).join(", ")}</dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  .breadcrumbs {
    padding-top: var(--space-md);
  }
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs);
  }
  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .breadcrumbs__item a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .breadcrumbs__item a:hover {
    color: var(--color-tiffany-text);
    text-decoration: underline;
  }
  .breadcrumbs__item [aria-current="page"] {
    color: var(--color-ink);
  }
  .breadcrumbs__sep {
    opacity: 0.5;
  }

  .book-hero {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-2xl);
  }
  .book-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .book-hero__title {
    font-style: italic;
    font-size: var(--step-5);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .book-hero__byline {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .book-hero__byline-link {
    color: var(--_accent-text);
  }
  .book-hero__media {
    display: flex;
    justify-content: center;
  }
  .book-hero__cover {
    width: 20rem;
  }
  .book-hero__cover .cover {
    box-shadow: var(--shadow-md);
  }
  @media (max-width: 900px) {
    .book-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .book-hero__media {
      order: -1;
    }
    .book-hero__cover {
      width: 16rem;
    }
    .book-hero__title {
      font-size: var(--step-4);
    }
  }
  @media (max-width: 480px) {
    .book-hero__cover {
      width: 13rem;
    }
  }

  .book-promise__inner {
    text-align: center;
  }
  .book-promise__inner .rule--accent {
    margin-inline: auto;
    margin-bottom: var(--space-sm);
  }
  .book-promise__statement {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--color-ink);
  }

  .book-description__hook {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    max-width: 48ch;
    color: var(--color-muted);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-hairline);
  }
  .book-description__blurb {
    max-width: 60ch;
  }
  .book-description__blurb p {
    font-size: var(--step-1);
    line-height: var(--leading-normal);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .book-description__blurb p:last-child {
    margin-bottom: 0;
  }

  .book-details__list {
    display: flex;
    flex-direction: column;
  }
  .book-details__row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: var(--border-hairline);
  }
  .book-details__row:first-child {
    border-top: var(--border-hairline);
  }
  .book-details__row dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .book-details__row dd {
    margin: 0;
    color: var(--color-ink);
  }
  @media (max-width: 560px) {
    .book-details__row {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
